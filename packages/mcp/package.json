{
  "name": "@codemodekit/mcp",
  "version": "0.3.0",
  "description": "MCP providers, transports, and downstream adapters for CodeModeKit.",
  "author": "Stephen Brown",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stjbrown/codemodekit.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/stjbrown/codemodekit#readme",
  "bugs": {
    "url": "https://github.com/stjbrown/codemodekit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/*.js", "dist/*.d.ts", "dist/*.map"],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@codemodekit/core": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@modelcontextprotocol/core": "2.0.0-beta.5",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "zod": "4.4.3"
  }
}
