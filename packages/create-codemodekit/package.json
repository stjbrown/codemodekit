{
  "name": "create-codemodekit",
  "version": "0.3.0",
  "description": "Scaffold runnable CodeModeKit servers and portable Agent Plugins from MCP commands.",
  "author": "Stephen Brown",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stjbrown/codemodekit.git",
    "directory": "packages/create-codemodekit"
  },
  "homepage": "https://github.com/stjbrown/codemodekit#readme",
  "bugs": {
    "url": "https://github.com/stjbrown/codemodekit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "create-codemodekit": "./dist/cli.js",
    "codemodekit-plugin": "./dist/plugin-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/*.js", "dist/*.d.ts", "dist/*.map", "skills/**/*"],
  "keywords": ["code-mode", "mcp", "model-context-protocol", "agent-plugin", "agent-skill", "scaffold"],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "esbuild": "0.28.1"
  }
}
