{
  "name": "@codemodekit/sandbox-quickjs",
  "version": "0.1.0",
  "description": "QuickJS/WASM sandbox backend for CodeModeKit.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stjbrown/codemodekit.git",
    "directory": "packages/sandbox-quickjs"
  },
  "homepage": "https://github.com/stjbrown/codemodekit#readme",
  "bugs": {
    "url": "https://github.com/stjbrown/codemodekit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/*.js", "dist/*.d.ts", "dist/*.map"],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@codemodekit/core": "workspace:*",
    "quickjs-emscripten": "0.32.0"
  }
}
