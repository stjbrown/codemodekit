{
  "name": "codemodekit",
  "version": "0.5.0",
  "description": "Build safe, programmable Code Mode servers from MCP and local tools.",
  "author": "Stephen Brown",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stjbrown/codemodekit.git",
    "directory": "packages/codemodekit"
  },
  "homepage": "https://github.com/stjbrown/codemodekit#readme",
  "bugs": {
    "url": "https://github.com/stjbrown/codemodekit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/*.js", "dist/*.d.ts", "dist/*.map"],
  "keywords": ["code-mode", "mcp", "model-context-protocol", "agents", "sandbox"],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "@codemodekit/core": "workspace:*",
    "@codemodekit/mcp": "workspace:*",
    "@codemodekit/sandbox-quickjs": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0-beta.5"
  }
}
