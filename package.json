{
  "name": "codemodekit-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stjbrown/codemodekit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "example:stdio": "node examples/dist/agent-plugin-stdio-server.js",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false"
  },
  "devDependencies": {
    "@codemodekit/core": "workspace:*",
    "@codemodekit/mcp": "workspace:*",
    "@codemodekit/sandbox-quickjs": "workspace:*",
    "codemodekit": "workspace:*",
    "create-codemodekit": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
